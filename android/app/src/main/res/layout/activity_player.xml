<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Full-screen video. media3's own controller is disabled — we draw our own. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:show_buffering="never"
        app:resize_mode="fit" />

    <!-- Single buffering spinner for mid-playback stalls (the big loading overlay covers
         the initial load). Only one of the two is ever visible. -->
    <ProgressBar
        android:id="@+id/buffering_spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:focusable="false"
        android:contentDescription="@string/cd_buffering"
        android:visibility="gone" />

    <!-- Loading / status overlay (episode backdrop + spinner) -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ep_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000" />

        <LinearLayout
            android:id="@+id/ep_info_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:id="@+id/ep_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:text="EP 1" />

            <TextView
                android:id="@+id/ep_series_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/cd_loading" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Salida del estado de error. Antes el overlay no tenía NADA focusable: con un mando
                 solo funcionaba ATRÁS, y nada lo decía. -->
            <LinearLayout
                android:id="@+id/error_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_error_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="@string/retry"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/card_focus_bg"
                    android:paddingHorizontal="24dp"
                    android:focusable="true"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btn_error_servers"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="@string/error_choose_source"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/card_focus_bg"
                    android:paddingHorizontal="24dp"
                    android:focusable="true"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btn_error_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="@string/error_exit"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/card_focus_bg"
                    android:paddingHorizontal="24dp"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Full custom controls overlay (all actions, reliable D-pad focus) -->
    <FrameLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- TOP: title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:background="@drawable/scrim_top"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="28dp"
            android:paddingBottom="52dp">

            <TextView
                android:id="@+id/ctrl_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ctrl_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- BOTTOM: progress + all buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/scrim_bottom"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <!-- Time row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ctrl_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:text="0:00" />

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/ctrl_timebar"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusDown="@id/btn_play_pause"
                    app:played_color="@color/accent_light"
                    app:bar_height="3dp" />

                <TextView
                    android:id="@+id/ctrl_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:text="0:00" />
            </LinearLayout>

            <!-- Controls row: transport icons (center) + actions (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- spacer to balance the right-side actions, keeping transport centered -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_prev_ep"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="14dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_previous"
                    android:background="@drawable/icon_button_bg"
                    android:contentDescription="Capítulo anterior"
                    android:focusable="true"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusRight="@id/btn_rew" />

                <ImageButton
                    android:id="@+id/btn_rew"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="14dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_replay_10"
                    android:background="@drawable/icon_button_bg"
                    android:contentDescription="Retroceder 10 segundos"
                    android:focusable="true"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusLeft="@id/btn_prev_ep"
                    android:nextFocusRight="@id/btn_play_pause" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginEnd="14dp"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause"
                    android:background="@drawable/icon_button_bg"
                    android:contentDescription="Reproducir o pausar"
                    android:focusable="true"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusLeft="@id/btn_rew"
                    android:nextFocusRight="@id/btn_ffwd" />

                <ImageButton
                    android:id="@+id/btn_ffwd"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="14dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_forward_10"
                    android:background="@drawable/icon_button_bg"
                    android:contentDescription="Avanzar 10 segundos"
                    android:focusable="true"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusLeft="@id/btn_play_pause"
                    android:nextFocusRight="@id/btn_next_ep" />

                <ImageButton
                    android:id="@+id/btn_next_ep"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next"
                    android:background="@drawable/icon_button_bg"
                    android:contentDescription="Capítulo siguiente"
                    android:focusable="true"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusLeft="@id/btn_ffwd"
                    android:nextFocusRight="@id/btn_servers" />

                <!-- right-side secondary actions -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_servers"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="12dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dns"
                    android:background="@drawable/icon_button_bg"
                    android:contentDescription="Servidores"
                    android:focusable="true"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusLeft="@id/btn_next_ep"
                    android:nextFocusRight="@id/btn_watched" />

                <ImageButton
                    android:id="@+id/btn_watched"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_check_circle_outline"
                    android:background="@drawable/icon_button_bg"
                    android:contentDescription="Marcar como visto"
                    android:focusable="true"
                    android:nextFocusUp="@id/ctrl_timebar"
                    android:nextFocusLeft="@id/btn_servers" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Server panel: right-side drawer (opened from the Servidores button) -->
    <LinearLayout
        android:id="@+id/server_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="@dimen/server_drawer_width"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#F0000000"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_servers"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="14dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/server_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </LinearLayout>

    <!-- Resume prompt -->
    <LinearLayout
        android:id="@+id/resume_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="@string/resume_title" />

        <TextView
            android:id="@+id/resume_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_resume"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="18dp"
                android:paddingStart="24dp"
                android:paddingEnd="28dp"
                android:text="@string/resume"
                android:drawableStart="@drawable/ic_play_arrow"
                android:drawablePadding="8dp"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_series_bg"
                android:focusable="true"
                android:nextFocusRight="@id/btn_restart" />

            <Button
                android:id="@+id/btn_restart"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:paddingStart="24dp"
                android:paddingEnd="28dp"
                android:text="@string/restart"
                android:drawableStart="@drawable/ic_replay"
                android:drawablePadding="8dp"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_series_bg"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_resume" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta de siguiente episodio (auto-play al estilo Netflix/Crunchyroll).
         ⚠️ ANCHO FIJO (@dimen/next_card_width): con wrap_content medía lo que el texto de la cuenta
         atrás, que cambia de ancho cada segundo ("…en 10 s" / "…en 9 s"), y como va anclada a la
         derecha el borde izquierdo daba saltos. Dentro, todo es match_parent o de tamaño fijo, y la
         cifra va con números tabulares (tnum): ningún tick puede redimensionar nada.
         Los ids son los que usan PlayerActivity y la rama modal de dispatchKeyEvent. -->
    <LinearLayout
        android:id="@+id/next_episode_card"
        android:layout_width="@dimen/next_card_width"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/tv_safe_h"
        android:layout_marginBottom="40dp"
        android:orientation="vertical"
        android:background="@drawable/next_card_bg"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- El fotograma del episodio que viene, a todo el ancho y en 16:9 (la proporción de las
             miniaturas del CDN, así que no se recorta nada). Altura FIJA: ver next_card_image_height. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/next_card_image_height">

            <ImageView
                android:id="@+id/next_ep_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/placeholder_color"
                android:contentDescription="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/next_card_scrim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/next_card_label_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/next_up"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/next_ep_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:shadowDy="1" />

                <TextView
                    android:id="@+id/next_ep_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:textColor="@color/accent_light"
                    android:textSize="12sp"
                    android:fontFeatureSettings="tnum"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:shadowDy="1" />
            </LinearLayout>

            <!-- La cuenta atrás en barra: se llena en los 10 s y se para si se pausa el vídeo. -->
            <ProgressBar
                android:id="@+id/next_ep_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/next_card_progress" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btn_play_next"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/play_now"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_play_arrow"
                android:drawablePadding="2dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_series_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn_cancel_next"
                android:nextFocusUp="@id/btn_play_next"
                android:nextFocusDown="@id/btn_play_next" />

            <Button
                android:id="@+id/btn_cancel_next"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/btn_series_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_play_next"
                android:nextFocusUp="@id/btn_cancel_next"
                android:nextFocusDown="@id/btn_cancel_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
