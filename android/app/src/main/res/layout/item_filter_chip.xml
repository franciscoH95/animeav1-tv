<?xml version="1.0" encoding="utf-8"?>
<!-- The value TextView carries the width cap (maxWidth on LinearLayout is a no-op) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:background="@drawable/filter_chip_bg"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true"
    android:layout_marginEnd="8dp">

    <!-- "Tipo: " label — fixed, never truncated -->
    <TextView
        android:id="@+id/chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:maxLines="1"
        android:text="Tipo:" />

    <!-- selected value — grows to fit, truncates only past the cap -->
    <TextView
        android:id="@+id/chip_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="220dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginStart="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Todos" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▾"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginStart="4dp" />

</LinearLayout>
