<?xml version="1.0" encoding="utf-8"?>
<!--
  Tile de episodio, con el fotograma del capítulo de fondo.

  La miniatura NO viene de la API: se arma con el id de la serie y el número del episodio (ver
  `AnimeImages`). Mide 220×124, así que en una TV 4K se estira; a este tamaño de tile es el precio
  razonable por reconocer un episodio de un vistazo en vez de leer un número.

  El tile mide lo que mida su imagen a 16:9 (`RatioImageView`), no una altura fija: así se ve el
  fotograma entero. El fondo tenue del hueco es lo que se ve mientras carga y en los episodios sin
  miniatura.

  ⚠️ El número va sobre un degradado y no sobre la imagen pelada: un fotograma claro dejaba el
  número blanco ilegible, y ~8% de las capturas son casi negras, así que tiene que leerse igual de
  bien con y sin imagen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/episode_tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ⚠️ El alto sale del ancho a 16:9 (`RatioImageView`) y es lo que da altura al tile entero:
         así el fotograma se ve COMPLETO, sin recorte, y el hueco mide lo mismo tenga imagen o no
         (el CDN devuelve 403 en los episodios sin miniatura). -->
    <com.animeav1.ui.RatioImageView
        android:id="@+id/ep_thumb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:background="#14FFFFFF"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay" />

    <TextView
        android:id="@+id/ep_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <!-- Watched checkmark overlay -->
    <TextView
        android:id="@+id/ep_watched"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:text="✓"
        android:textColor="#FF4CAF50"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:visibility="gone" />

    <!-- "A medias": franja inferior con lo que llevas del episodio. Sale de episode_progress, así
         que un episodio empezado y no terminado se distingue de uno intacto sin abrirlo. -->
    <View
        android:id="@+id/ep_progress"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom|start"
        android:background="@color/accent"
        android:visibility="gone" />

    <!-- "Siguiente a ver". Un punto y NO un borde de acento: el borde es el estado de foco y las
         dos marcas juntas serían indistinguibles. -->
    <TextView
        android:id="@+id/ep_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:text="●"
        android:textColor="@color/accent_light"
        android:textSize="10sp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:visibility="gone" />

</FrameLayout>
