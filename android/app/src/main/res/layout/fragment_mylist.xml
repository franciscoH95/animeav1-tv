<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Cabecera de la sección: título + sub-listas. El perfil y la copia se han movido a Ajustes
         del perfil (avatar de la barra global): aquí eran acciones de app metidas en una sección.
         @id/section_menu es lo que MainActivity usa para el nivel intermedio de BACK. -->
    <LinearLayout
        android:id="@+id/section_menu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tv_safe_h"
        android:paddingEnd="@dimen/tv_safe_h"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_mylist"
            android:drawableStart="@drawable/ic_list"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_list_por_ver"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/list_por_ver"
                    android:textSize="13sp"
                    android:textColor="@drawable/tab_text_color"
                    android:background="@drawable/tab_background"
                    android:paddingHorizontal="16dp"
                    android:focusable="true"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_list_viendo"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/list_viendo"
                    android:textSize="13sp"
                    android:textColor="@drawable/tab_text_color"
                    android:background="@drawable/tab_background"
                    android:paddingHorizontal="16dp"
                    android:focusable="true"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_list_completadas"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/list_completadas"
                    android:textSize="13sp"
                    android:textColor="@drawable/tab_text_color"
                    android:background="@drawable/tab_background"
                    android:paddingHorizontal="16dp"
                    android:focusable="true"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_list_favoritos"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/list_favoritos"
                    android:textSize="13sp"
                    android:textColor="@drawable/tab_text_color"
                    android:background="@drawable/tab_background"
                    android:paddingHorizontal="16dp"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF" />

    <!-- Content: grid + centered empty state (same FrameLayout pattern as the other grids) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/mylist_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@drawable/ic_empty"
            android:drawablePadding="14dp"
            android:text="@string/mylist_empty"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mylist_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/tv_safe_h"
            android:paddingVertical="@dimen/tv_safe_v"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:focusable="true"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>

</LinearLayout>
