<?xml version="1.0" encoding="utf-8"?>
<!--
  Aviso de versión nueva (OTA). Pantalla propia y no un overlay dentro de MainActivity: así el foco
  del D-pad queda aislado en su propia ventana sin competir con la pregunta de salir ni con las
  pestañas (un overlay VISIBLE no aísla nada, ver ExitConfirm).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_safe_h"
        android:paddingEnd="@dimen/tv_safe_h">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_light"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/update_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="6"
            android:ellipsize="end"
            android:layout_marginTop="14dp" />

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/update_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="26dp">

            <Button
                android:id="@+id/btn_update_now"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/update_now"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/card_focus_bg"
                android:paddingHorizontal="24dp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_update_later"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/update_later"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/card_focus_bg"
                android:paddingHorizontal="24dp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
