<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Solo para escribir la copia de seguridad en Descargas en API <= 28. Desde API 29 se hace
         por MediaStore, que no pide permiso, de ahí el maxSdkVersion. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Ver las copias de seguridad que dejó una instalación ANTERIOR. MediaStore solo devuelve lo
         que escribió esta instalación, así que sin esto la lista sale vacía justo cuando hace falta
         restaurar: tras reinstalar. El usuario lo concede en Ajustes, y sin ello la app sigue
         funcionando (solo ve sus propias copias). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Actualizaciones OTA: instalar el APK descargado. Desde API 26 el usuario tiene además que
         autorizar a esta app en "orígenes desconocidos" (ver ApkInstaller.canInstall). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".AnimeApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.AnimeAV1"
        android:usesCleartextTraffic="true">

        <!-- La presentación de arranque es la puerta de entrada: se cierra a sí misma al lanzar
             MainActivity, así que no se queda en la pila y BACK desde el selector de perfiles sigue
             saliendo de la app. -->
        <activity
            android:name=".ui.IntroActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".ui.series.SeriesActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:theme="@style/Theme.AnimeAV1.Player" />

        <activity
            android:name=".ui.profile.ProfilesActivity"
            android:exported="false"
            android:windowSoftInputMode="stateUnchanged"
            android:configChanges="keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".ui.profile.ProfileSettingsActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".ui.backup.BackupActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".ui.browse.SearchActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateUnchanged" />


        <activity
            android:name=".ui.update.UpdateActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Desenlace de la sesión de instalación. No exportado: solo lo despierta el PendingIntent
             que crea la propia app. -->
        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
